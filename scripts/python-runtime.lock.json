  "overlays": [
    {
      "why": "周立功（ZLG）USBCAN 后端：本机维护的 python-can 补丁，不在任何索引上",
      "from": "python-can-zlg",
      "to": "can/interfaces/zlg",
      "scope": "extras"
    },
    {
      "why": "把 zlg 后端注册进 python-can 的 BACKENDS",
      "type": "patch",
      "file": "can/interfaces/__init__.py",
      "replace": [
        {
          "find": "    \"virtual\",\n]",
          "with": "    \"virtual\",\n    \"zlg\",\n]"
        },
        {
          "find": "    \"socketcand\": (\"can.interfaces.socketcand\", \"SocketCanDaemonBus\"),\n}",
          "with": "    \"socketcand\": (\"can.interfaces.socketcand\", \"SocketCanDaemonBus\"),\n    \"zlg\": (\"can.interfaces.zlg\", \"ZlgUsbCanBus\"),\n}"
        }
      ],
      "scope": "extras"
    },
    {
      "why": "让 pip --target 目录像真正的 site 目录：pywin32 的 .pth 与 DLL 目录只在 site 目录生效",
      "from": "sitecustomize.py",
      "to": "sitecustomize.py",
      "scope": "extras"
    }
  ],
