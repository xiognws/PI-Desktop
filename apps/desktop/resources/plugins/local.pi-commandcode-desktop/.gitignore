# Build output. The .piplug is reproducible with `PluginPack`; publishing a binary
# blob makes review harder and is not needed to install a development plugin.
dist/

# Installed dependencies (this plugin has none, but a stray install must not
# reach the repository).
node_modules/

# Local scratch, editor and OS noise.
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Credentials and machine-local state must never be committed. Nothing here is
# written by this plugin (it stores credentials in PI-Desktop's own plugin data
# directory, outside the repository), but these are the paths a contributor's
# machine might already have beside the checkout.
auth.json
.commandcode/
.pi/agent/
.omp/
