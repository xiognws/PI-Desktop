{
  "name": "@pi-workspace/desktop",
  "version": "0.21.0",
  "desktopName": "pi-workspace.desktop",
  "private": true,
  "description": "Pi-Workspace Electron application",
  "homepage": "https://github.com/xiognws/PI-Desktop",
  "author": {
    "name": "vastsa",
    "email": "hhxk666@gmail.com"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter '@pi-workspace/desktop^...' build",
    "predev": "pnpm run build:deps && cargo build --manifest-path ../../Cargo.toml -p host-core",
    "dev": "node ../../scripts/dev-electron.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs && node --test electron/test/*.test.mjs",
    "lint": "node ../../scripts/check-style-tokens.mjs",
    "clean": "node -e \"fs.rmSync('out',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true})\"",
    "build:host-release": "cargo build --release --manifest-path ../../Cargo.toml -p host-core",
    "bundle:runtime": "pnpm -C ../../packages/agent-runtime bundle",
    "bundle:python": "node ../../scripts/bundle-python-runtime.mjs",
    "stage:manual": "node ../../scripts/stage-desktop-manual.mjs",
    "pack": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run bundle:python && pnpm run bundle:autotest-ui && pnpm run stage:manual && electron-vite build && electron-builder --dir",
    "dist": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run bundle:python && pnpm run bundle:autotest-ui && pnpm run stage:manual && electron-vite build && node ../../scripts/build-desktop-release.mjs",
    "dist:mac": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run stage:manual && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run bundle:python && pnpm run bundle:autotest-ui && pnpm run stage:manual && electron-vite build && node ../../scripts/build-desktop-release.mjs win",
    "dist:linux": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && pnpm run stage:manual && electron-vite build && electron-builder --linux --publish never",
    "bundle:autotest-ui": "npm --prefix ../../services/autotest/ui ci --no-audit --no-fund && npm --prefix ../../services/autotest/ui run build"
  },
  "dependencies": {
    "@ast-grep/napi": "0.51.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@pi-workspace/agent-host": "workspace:*",
    "@pi-workspace/computer-use": "workspace:*",
    "@pi-workspace/agent-runtime": "workspace:*",
    "@pi-workspace/host-runtime": "workspace:*",
    "@pi-workspace/i18n": "workspace:*",
    "@pi-workspace/plugin-devkit": "workspace:*",
    "@pi-workspace/plugin-sdk": "workspace:*",
    "@pi-workspace/racp": "workspace:*",
    "@pi-workspace/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "dompurify": "^3.4.17",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "i18next": "^26.3.6",
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "pinyin-pro": "3.29.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.6",
    "ws": "8.21.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "net.aiuo.pi-workspace",
    "productName": "Pi-Workspace",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xiognws",
        "repo": "PI-Desktop"
      }
    ],
    "extraMetadata": {
      "piDistribution": "installed"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{test,tests,__tests__,powered-test,example,examples}/**",
      "!**/node_modules/**/*.{test,spec}.{js,cjs,mjs}",
      "!**/node_modules/node-addon-api/tools/**",
      "!**/node_modules/node-addon-api/*.{c,gyp,gypi,h,js,json}",
      "!**/node_modules/node-addon-api/README.md"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW",
      "tr",
      "de",
      "es",
      "fr",
      "ko",
      "pt-BR",
      "pt_BR"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "../../packages/agent-runtime/dist-bundle",
        "to": "agent-runtime"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/gen-ui",
        "to": "gen-ui"
      },
      {
        "from": "resources/plugins",
        "to": "plugins"
      },
      {
        "from": "resources/tools",
        "to": "tools"
      },
      {
        "from": "resources/models.dev",
        "to": "models.dev"
      },
      {
        "from": "resources/python",
        "to": "python"
      },
      {
        "from": "resources/manual",
        "to": "manual"
      },
      {
        "from": "../../services/autotest/src",
        "to": "autotest/src"
      },
      {
        "from": "../../services/autotest/ui-shell",
        "to": "autotest/ui-shell"
      },
      {
        "from": "../../services/autotest/ui/dist",
        "to": "autotest/ui/dist"
      },
      {
        "from": "../../services/autotest/runner",
        "to": "autotest/runner"
      },
      {
        "from": "../../services/autotest/.deps",
        "to": "autotest/.deps"
      }
    ],
    "mac": {
      "artifactName": "Pi-Workspace-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Pi-Workspace needs local network access so agents can reach OpenAI-compatible providers, Ollama, and other AI endpoints running on your LAN. / Pi-Workspace 需要本地网络访问权限，以便助手请求同一局域网中的 OpenAI 兼容服务、Ollama 等本地 AI 端点。",
        "NSMicrophoneUsageDescription": "Pi-Workspace uses the microphone for Live voice calls and authorized plugin audio access. / Pi-Workspace 使用麦克风进行实时语音通话，以及你已授权的插件音频访问。",
        "NSBonjourServices": [
          "_http._tcp",
          "_https._tcp"
        ]
      },
      "extraResources": [
        {
          "from": "../../target/release/pi-desktop-host-core",
          "to": "bin/pi-desktop-host-core"
        },
        {
          "from": "build/tray-icon-mac.png",
          "to": "tray-icon-mac.png"
        }
      ]
    },
    "dmg": {
      "artifactName": "Pi-Workspace-${version}-${arch}.${ext}",
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "window": {
        "width": 720,
        "height": 440
      },
      "iconSize": 128,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 180,
          "y": 196
        },
        {
          "x": 540,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "executableName": "Pi-Workspace",
      "artifactName": "Pi-Workspace-Portable-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/app-update.yml",
          "to": "app-update.yml"
        },
        {
          "from": "../../target/release/pi-desktop-host-core.exe",
          "to": "bin/pi-desktop-host-core.exe"
        },
        {
          "from": "build/icon.ico",
          "to": "app-icon.ico"
        },
        {
          "from": "build/icon.png",
          "to": "app-icon.png"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pi-Workspace",
      "artifactName": "Pi-Workspace-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Pi-Workspace-Portable-${version}.${ext}"
    },
    "deb": {
      "packageName": "pi-workspace",
      "artifactName": "pi-workspace_${version}_${arch}.${ext}"
    },
    "rpm": {
      "packageName": "pi-workspace",
      "artifactName": "pi-workspace-${version}-${arch}.${ext}",
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "linux": {
      "executableName": "pi-workspace",
      "syncDesktopName": true,
      "artifactName": "Pi-Workspace-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        },
        {
          "target": "rpm"
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "../../target/release/pi-desktop-host-core",
          "to": "bin/pi-desktop-host-core"
        }
      ]
    },
    "asarUnpack": [
      "node_modules/@ast-grep/napi/**/*.node",
      "node_modules/@ast-grep/napi-*/**/*.node"
    ],
    "asar": {
      "smartUnpack": false
    }
  }
}
